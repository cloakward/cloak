# Build artefacts and editor noise - these would balloon the build
# context (and thus the time spent shipping it to the daemon) without
# contributing to the image.
target/
**/target/
**/node_modules/
**/dist/
.git/
.github/
.idea/
.vscode/
*.log
.DS_Store

# Unrelated workspaces - the Dockerfile only builds `cloak-core`'s
# `cloakd` and `cloak` binaries, so packaging the bun-compiled MCP shim,
# docs, and unrelated install scripts would be wasted I/O. The pinned
# libsodium prep script is intentionally kept because the Dockerfile runs it.
# (The `crates/cloak-core/tests/` directory stays in context because Cargo
# enumerates the workspace during `cargo build`; we just don't compile tests.)
packages/
docs/
scripts/*
!scripts/prepare-libsodium-dist.sh
Dockerfile
.dockerignore

# Compiler / linker scratch files
*.swp
*.swo
*~
