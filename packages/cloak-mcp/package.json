{
  "name": "@cloak-ward/mcp",
  "version": "1.1.0",
  "description": "Cloak MCP server: the model surface that never sees plaintext secrets.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cloakward/cloak#readme",
  "bugs": {
    "url": "https://github.com/cloakward/cloak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloakward/cloak.git",
    "directory": "packages/cloak-mcp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/cloak-mcp.mjs",
    "src/**/*.ts",
    "scripts/check-no-http.mjs",
    "tsconfig.json",
    "package.json",
    "README.md",
    "LICENSE*"
  ],
  "type": "module",
  "main": "src/server.ts",
  "bin": {
    "cloak-mcp": "bin/cloak-mcp.mjs"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --compile --outfile dist/cloak-mcp",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "self-test": "bun run src/self-test.ts",
    "lint:no-http": "node scripts/check-no-http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "hono": "4.12.21",
    "ip-address": "10.1.1",
    "qs": "6.15.2"
  }
}
